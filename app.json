{
  "expo": {
    "name": "consumerhack",
    "slug": "consumerhack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "consumerhack",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.akhileshrangani.consumerhack",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The voice agent listens through the microphone only while it is awake, after you draw a clockwise circle.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.akhileshrangani.consumerhack",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The voice agent listens through the microphone only while it is awake, after you draw a clockwise circle.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "The voice agent listens through the microphone only while it is awake, after you draw a clockwise circle.",
          "cameraPermission": "The camera is used only when you ask the app to describe what is in front of you."
        }
      ],
      [
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableCamera": false,
          "enableMicrophone": true,
          "enableScreenShare": false,
          "microphonePermission": "The voice agent listens through the microphone only while it is awake, after you draw a clockwise circle."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
