    "jest-expo": "^58.0.14",
    "jpeg-js": "^0.4.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "convex:dev": "convex dev",
    "eval:agent": "jest --testRegex 'src/agent/__eval__/vapiChat\\.eval\\.ts$' --testTimeout 900000",
    "eval:memory-proof": "esbuild src/agent/__eval__/memoryProof.run.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=.eval/memory-proof.cjs --alias:react-native=./src/agent/__eval__/nativeShim.ts --alias:expo-secure-store=./src/agent/__eval__/nativeShim.ts && node .eval/memory-proof.cjs",
    "eval:bluesky": "esbuild src/agent/__eval__/bluesky.run.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=.eval/bluesky.cjs --alias:react-native=./src/agent/__eval__/nativeShim.ts --alias:expo-secure-store=./src/agent/__eval__/nativeShim.ts && node .eval/bluesky.cjs",
    "eval:look": "esbuild scripts/look-eval.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=.eval/look.cjs --loader:.jpg=empty && node .eval/look.cjs"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2"
}
