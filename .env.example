# Copy to .env.local. Every variable is optional: the app runs with none of them set.

# Convex deployment URL the app talks to (printed by `pnpm convex:dev`, also in the Convex dashboard).
# Without it the app skips Convex: no description cache and no user records.
EXPO_PUBLIC_CONVEX_URL=

# Bluesky PDS used for sign in. Defaults to https://bsky.social.
EXPO_PUBLIC_BLUESKY_SERVICE=

# at:// URI of the feed generator shown when signed out. Defaults to Bluesky's Discover feed.
EXPO_PUBLIC_BLUESKY_DEMO_FEED=

# Server-side only, set in the Convex deployment with `npx convex env set` and never here or in the app:
#   OPENAI_API_KEY   key for the post description model (convex/describe.ts)
#   DESCRIBE_MODEL   optional model id, defaults to gpt-6-luna

# Origin that serves Juno's Bluesky OAuth client metadata at /oauth/client-metadata.json (the OAuth client id).
# Defaults to https://dependable-goshawk-583.convex.site, the Convex HTTP action in convex/oauth.ts.
EXPO_PUBLIC_BLUESKY_OAUTH_ORIGIN=

# Convex deploy key, read by `npx convex deploy` and `npx convex codegen` in CI and on servers.
# Never bundled into the app. Create it in the Convex dashboard under Settings, Deploy keys.
CONVEX_DEPLOY_KEY=

# Vapi public key for the voice agent. Public keys are meant to ship in apps; without it the agent says it
# isn't set up and the app goes back to scrolling.
EXPO_PUBLIC_VAPI_PUBLIC_KEY=

# Set to 1 only in test builds: the link juno://dev-agent (or the older consumerhack://dev-agent) then wakes
# the agent without drawing a circle (cloud phones cannot draw one). Builds without it compile the link handling out.
EXPO_PUBLIC_DEV_AGENT_LINK=

# Server-side only. Set in the Convex deployment with `npx convex env set NAME "$NAME"`, never in the app or in .env.local:
# SUPERMEMORY_API_KEY   read by convex/memory.ts (per-user memory). The only secret the voice agent's Convex code reads.
#
# Developer shell only, for the agent tests in src/agent/__eval__. Never set in the app, and not needed in Convex
# by the voice agent (nothing deployed forwards prompts to a model):
# VAPI_PRIVATE_KEY            pnpm eval:agent, Vapi's chat API
# OPENAI_API_KEY              EVAL_BACKEND=openai pnpm eval:agent, the stand-in on the assistant's own model
# BLUESKY_TEST_HANDLE         pnpm eval:bluesky, a throwaway test account it posts to and cleans up; pnpm eval:memory-proof
# BLUESKY_TEST_APP_PASSWORD   pnpm eval:bluesky, pnpm eval:memory-proof
